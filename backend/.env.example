# Django Configuration
SECRET_KEY=django-insecure-lambda-mobility-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL with PostGIS)
# Example for PostgreSQL: postgresql://postgres:postgres@localhost:5432/urban_intelligence
# Leave blank for zero-dependency local SQLite development
DATABASE_URL=
POSTGRES_DB=urban_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=
POSTGRES_PORT=5432

# CORS Configuration (React Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Redis & Celery (Set USE_REDIS=True if Redis is running)
USE_REDIS=False
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Prototype Configuration
DEMO_MODE=True
