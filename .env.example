# Lambda Environment Configuration

# Backend REST API URL (Optional: defaults to http://localhost:8000/api if unset)
# Set this to your production backend URL or Cloudflare Worker API URL
VITE_API_URL=http://localhost:8000/api

# OpenStreetMap / Custom Leaflet Tile Server (Optional)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Traccar GPS Ingestion / Live Tracking Service (Optional)
VITE_TRACCAR_URL=

# AI Journey Assist API Key (Optional: OpenRouter / Gemini API)
VITE_OPENROUTER_API_KEY=
